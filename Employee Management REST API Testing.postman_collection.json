    {
      "name": "TC01 - Get all employees",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\",function(){\r\n    pm.response.to.have.status(200);\r\n});\r\npm.test(\"Response is a JSON array\",function(){\r\n    const data = pm.response.json();\r\n    pm.expect(data).to.be.an(\"array\");\r\n});\r\npm.test(\"Employee-like records have rrqynu\")\r\n"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://gorest.in/public/v2/users",
          "protocol": "https",
          "host": [
