    {
      "name": "TC03 - Update an employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Employee name is updated\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data.name).to.eql(\"Updated Test Employee\");\r\n});\r\n\r\npm.test(\"Employee email is updated\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data.email).to.include(\"updated.\");\r\n});\r\n\r\npm.test(\"Employee ID is present\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data.id).to.exist;\r\n});\r\n"
            ]
          }
        }
      ],
