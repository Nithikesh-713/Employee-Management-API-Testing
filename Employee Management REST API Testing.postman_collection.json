    {
      "name": "TC02 - Create an employee like record",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "\r\npm.test(\"Status code is 201 Created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.test(\"Response contains an employee ID\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data.id).to.exist;\r\n});\r\n\r\npm.test(\"Employee name matches request\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data.name).to.eql(\"Test Employee\");\r\n});\r\n\r\npm.test(\"Employee email is present\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data.email).to.include(\"@example.com\");\r\n});\r\n"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "7e8e93a3cf3a7493f7c4b2e71debf5d66722bd24cd86bb9e367d65b75c6f9a0a",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "\r\n{\r\n  \"name\": \"Test Employee\",\r\n  \"email\": \"employee.{{$timestamp}}@example.com\",\r\n  \"gender\": \"male\",\r\n  \"status\": \"active\"\r\n}\r\n\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://gorest.in/public/v2/users",
          "protocol": "https",
          "host": [
            "gorest",
            "in"
          ],
          "path": [
            "public",
            "v2",
            "users"
          ]
        }
